# Copy to .env (git-ignored). Values already in the environment win over this file.

# --- LLM for query understanding (optional; without it a rule-based parser is used) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternative provider:
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini        # gemini | anthropic | none   (default: Gemini if its key is set, else Anthropic)
# LLM_MODEL=gemini-flash-latest # overrides the provider default
# LLM_TIMEOUT_S=20

# --- Maintainer token, 16+ characters (if omitted a random one is generated and logged at startup) ---
# ADMIN_TOKEN=
